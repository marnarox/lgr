# Copier ce fichier vers .env et remplacer les quatre valeurs.
# Sur ce PC, conserver le .env existant : les bases utilisent deja ses mots de passe.
DINGDING_DB_PASSWORD=replace-with-a-unique-password
DINGDING_ROOT_PASSWORD=replace-with-another-unique-password
LGR_DB_PASSWORD=replace-with-a-unique-lgr-password
LGR_ROOT_PASSWORD=replace-with-another-unique-lgr-password
